<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Service home with standard Account, Lead, Case, and OpenTasks list view cards.</description>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties><name>entityName</name><value>Account</value></componentInstanceProperties>
                <componentInstanceProperties><name>filterName</name><value>RecentlyViewedAccounts</value></componentInstanceProperties>
                <componentName>flexipage:filterListCard</componentName>
                <identifier>recentAccounts</identifier>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties><name>entityName</name><value>Task</value></componentInstanceProperties>
                <componentInstanceProperties><name>filterName</name><value>OpenTasks</value></componentInstanceProperties>
                <componentName>flexipage:filterListCard</componentName>
                <identifier>myOpenTasks</identifier>
            </componentInstance>
        </itemInstances>
        <name>bottomLeft</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties><name>entityName</name><value>Lead</value></componentInstanceProperties>
                <componentInstanceProperties><name>filterName</name><value>Service_My_Leads</value></componentInstanceProperties>
                <componentName>flexipage:filterListCard</componentName>
                <identifier>recentLeads</identifier>
            </componentInstance>
        </itemInstances>
        <name>bottomRight</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties><name>entityName</name><value>Case</value></componentInstanceProperties>
                <componentInstanceProperties><name>filterName</name><value>MyOpenCases</value></componentInstanceProperties>
                <componentName>flexipage:filterListCard</componentName>
                <identifier>recentCases</identifier>
            </componentInstance>
        </itemInstances>
        <name>sidebar</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>דף הבית לנציג שירות</masterLabel>
    <template>
        <name>home:desktopTemplate</name>
    </template>
    <type>HomePage</type>
</FlexiPage>
